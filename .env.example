# MCP Data Assistant - Environment Configuration
# Copy this file to .env and adjust as needed

# Backend and Frontend server settings
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8200
FRONTEND_PORT=3200

# MCP server settings
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8020
MCP_SERVER_PATH=/mcp
MCP_SERVER_URL=http://127.0.0.1:8020/mcp
MCP_HTTP_TIMEOUT_SECONDS=30

# Database path (relative to project root)
DB_PATH=data/sample.db

# Dataset directory (relative to project root)
DATASETS_DIR=data/datasets

# Ollama settings (optional - for local LLM)
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Safety settings
READ_ONLY_MODE=true
MAX_RESULTS=100

# SQLite and MCP Mode Configurations
# Demo Mode Setup:
MCP_MODE=demo
DATABASE_TYPE=sqlite
SQLITE_DB_PATH=./data/sample.db
DATASET_DIR=./data/datasets
READ_ONLY_MODE=true

# Real Mode Setup (uncomment and configure to use a real database):
# MCP_MODE=real
# DATABASE_TYPE=sqlite
# SQLITE_DB_PATH=./data/real_db/your_database.db
# DATASET_DIR=./data/real_datasets
# READ_ONLY_MODE=true
